# Vercel server environment only; set real values in Vercel Project Settings.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-secret
AGENT_TOKEN=replace-with-long-random-secret
CONTROL_TOKEN=replace-with-another-long-random-secret

# Local bridge process only. Keep this endpoint on loopback.
BRIDGE_URL=https://your-vercel-domain.vercel.app
AGENT_TOKEN=replace-with-long-random-secret
LOCAL_AGENT_URL=http://127.0.0.1:1234/agent
LOCAL_AGENT_TOKEN=
POLL_SECONDS=2
