# GitHub API Bridge (recommended for Arena <-> local OpenCode; local machine only).
# Optional if already logged in via `gh auth login` or Git Credential Manager.
BRIDGE_REPO=alilus/mysite
BRIDGE_ISSUE=1
BRIDGE_ALLOWED_USER=alilus
# BRIDGE_GITHUB_TOKEN=replace-with-fine-grained-pat
# OPENCODE_WORKDIR=C:\ruta\a\tu\proyecto
# OPENCODE_AUTO=0
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=

# Vercel/Render server environment only; set real values in hosting settings.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-secret
AGENT_TOKEN=replace-with-long-random-secret
CONTROL_TOKEN=replace-with-another-long-random-secret

# Local bridge process only. Keep this endpoint on loopback.
BRIDGE_URL=https://your-vercel-domain.vercel.app
AGENT_TOKEN=replace-with-long-random-secret
LOCAL_AGENT_URL=http://127.0.0.1:1234/agent
LOCAL_AGENT_TOKEN=
POLL_SECONDS=2
